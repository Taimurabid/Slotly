# Copy to .env and adjust. Every variable is validated at startup (src/config/env.ts);
# the app refuses to boot if one is missing or malformed.

# development | test | production
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Postgres connection string. Locally this points at the docker-compose "db" service.
# On Neon, use the pooled connection string and append ?sslmode=require
DATABASE_URL=postgres://slotly:slotly@localhost:5432/slotly

# Secret used to sign JWT access tokens. At least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Access token lifetime (any value accepted by @fastify/jwt, e.g. 15m, 1h)
JWT_ACCESS_TTL=15m
# Refresh token lifetime in days
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of allowed browser origins for CORS
CORS_ORIGINS=http://localhost:5173

# Max requests per minute per IP on /auth/* routes
RATE_LIMIT_AUTH_MAX=10
